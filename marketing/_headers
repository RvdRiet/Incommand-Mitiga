# Security headers for the PUBLIC marketing site.
# Format: Cloudflare Pages / Netlify `_headers`. (Vercel uses vercel.json instead.)
# This site is 100% static — there is no application backend to attack or crash.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-DNS-Prefetch-Control: off

# HTML: short cache so copy/pricing updates propagate fast, but still edge-cached.
/*.html
  Cache-Control: public, max-age=600, must-revalidate

# Immutable static assets can be cached hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
