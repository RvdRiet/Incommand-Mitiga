{
  "name": "incommand-mitiga",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "dev:core": "cross-env NEXT_PUBLIC_EDITION=command_core next dev",
    "build:core": "cross-env NEXT_PUBLIC_EDITION=command_core next build",
    "start:core": "cross-env NEXT_PUBLIC_EDITION=command_core next start",
    "stack": "node scripts/dev-stack.mjs",
    "livekit:field": "docker compose -f docker-compose.yml -f docker-compose.field.yml up -d livekit",
    "livekit:dev": "docker compose up -d --force-recreate livekit",
    "gen:sw": "node scripts/gen-sw.mjs",
    "gen:demo-seed": "node scripts/gen-demo-seed.mjs",
    "prebuild": "node scripts/gen-sw.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:status": "tsx scripts/migrate.ts --status",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:deploy": "tsx scripts/db-deploy.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:new-tenant": "tsx scripts/create-tenant.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:prepare": "npm run build && node electron/prepare.mjs",
    "electron:dev": "cross-env ELECTRON_DEV=1 electron electron/main.js",
    "electron": "electron electron/main.js",
    "electron:pack": "npm run electron:prepare && node electron/package.mjs",
    "electron:installer": "npm run electron:pack && node electron/installer.mjs",
    "electron:sign": "node scripts/sign-win.mjs",
    "electron:dist": "npm run electron:pack && node scripts/sign-win.mjs",
    "electron:build": "npm run electron:prepare && electron-builder",
    "verify:routes": "tsx scripts/verify-routes.ts",
    "telemetry": "tsx server/telemetry-server.ts",
    "paging": "tsx server/paging-server.ts",
    "signaling": "tsx server/signaling-server.ts",
    "mqtt-bridge": "tsx server/mqtt-bridge.ts"
  },
  "build": {
    "appId": "com.incommand.desktop",
    "productName": "InCommand",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  },
  "dependencies": {
    "@astryxdesign/cli": "^0.3.0",
    "@astryxdesign/core": "^0.3.0",
    "@astryxdesign/theme-neutral": "^0.3.0",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@livekit/components-react": "^2.9.23",
    "@livekit/components-styles": "^1.2.0",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^2.4.3",
    "dexie": "^4.4.5",
    "drizzle-orm": "^0.41.0",
    "geojson": "^0.5.0",
    "html2canvas": "^1.4.1",
    "ioredis": "^5.11.1",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "livekit-client": "^2.20.1",
    "livekit-server-sdk": "^2.17.0",
    "maplibre-gl": "^5.5.0",
    "mqtt": "^5.15.2",
    "next": "^15.3.2",
    "next-auth": "^5.0.0-beta.28",
    "nodemailer": "^7.0.13",
    "otplib": "^12.0.1",
    "postgres": "^3.4.5",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sip.js": "^0.21.2",
    "ws": "^8.21.0",
    "zod": "^3.24.4",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "@eslint/eslintrc": "^3.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.15.17",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.3",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-winstaller": "^5.4.0",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.3.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
