# Database (Postgres 15+ with PostGIS) — two-role model for multi-tenant RLS.
# The APP connects as a NON-superuser role so row-level security actually
# enforces tenant isolation (a superuser/BYPASSRLS role silently defeats it).
DATABASE_URL=postgres://mitiga_app:mitiga_app_dev@localhost:5432/mitiga
# Admin connection used ONLY by migrations + seed (creates tenants, runs DDL).
# In production this is a privileged role; the app process must never use it.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/mitiga

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Map basemaps — defaults to Google-like Esri streets (light) + dark gray (dark).
# Optional: MapTiler Streets v2 (closest to Google Maps) — https://www.maptiler.com/
# Also powers the Satellite + Hybrid layer toggle (falls back to free Esri World
# Imagery when unset — both are cacheable/offline-friendly, unlike Google tiles).
# NEXT_PUBLIC_MAPTILER_API_KEY=
# Override light/dark tile URLs only if needed:
# NEXT_PUBLIC_OSM_TILE_URL=
# NEXT_PUBLIC_OSM_TILE_DARK_URL=

# Google Maps key (server-side only). Enables, when set:
#  • Geocoding — Google address→coords (falls back to Nominatim/OSM when unset)
#  • Routing — Google traffic-aware primary route (OSRM stays the offline backup)
# Restrict the key to Geocoding + Directions APIs. Leave blank to run fully on OSM.
GOOGLE_MAPS_API_KEY=
# Optional ISO country bias for Google geocoding, e.g. za (South Africa).
# GEOCODE_REGION=za

# Weather provider override: auto | nws | openmeteo
NEXT_PUBLIC_WEATHER_PROVIDER=auto

# South Africa load shedding (optional — national status works without these)
# Free tier: https://eskomsepush.gumroad.com/l/api (50 requests/day, personal use)
ESP_API_TOKEN=
# Fixed ESP area id (optional; otherwise resolved from incident lat/lng via areas_nearby)
# LOADSHEDDING_AREA_ID=jhbcitypower3-5-goldenharvestah

# Residents: Census 2022 municipal populations are bundled (Stats SA) — no API key required.
# Search on the Residents module auto-fills city, province, and official population totals.

# Live Ops telemetry (RFC-005). Unset → the map uses a local simulation. Set it to the
# telemetry service (run `npm run telemetry`) to relay real/demo unit GPS over the wire.
# NEXT_PUBLIC_TELEMETRY_WS_URL=ws://localhost:8787
# Paging service (run `npm run paging`) — relays page delivery/ACK receipts. Unset → local sim.
# NEXT_PUBLIC_PAGING_WS_URL=ws://localhost:8788
# Signaling service (run `npm run signaling`) — channel presence + PTT floor control.
# NEXT_PUBLIC_SIGNALING_WS_URL=ws://localhost:8789
# MQTT→telemetry bridge (`npm run mqtt-bridge`): relays the L310 bodycam app's MQTT location
# onto the InCommand map. Set the circle join key and target incident:
# MQTT_CIRCLE=ABC123.XY12ABCD
# INCIDENT_ID=00000000-0000-4000-8000-000000000001

# SIP push-to-talk against the fleet Asterisk (RFC-006). Needs a WSS transport + operator
# endpoint added to Asterisk first. Credentials here are LOCAL-TEST ONLY — production must
# mint the operator's SIP secret server-side, never ship it in the client bundle.
# NEXT_PUBLIC_SIP_WSS_URL=wss://sip.yourdomain.example:8089/ws
# NEXT_PUBLIC_SIP_DOMAIN=sip.yourdomain.example
# NEXT_PUBLIC_SIP_USER=operator1
# NEXT_PUBLIC_SIP_PASSWORD=local-test-only

# LiveKit live bodycam video (RFC-007). Server-side keys mint operator subscribe tokens;
# NEXT_PUBLIC_LIVEKIT_URL just tells the client video is available (real url comes from the token).
# LAN-IP FALLBACK: when LIVEKIT_URL's host is a private-LAN IP or localhost, the server
# swaps in the machine's CURRENT LAN IP at token time (same /24 as the configured host),
# so a DHCP change self-heals for phones on the LAN. Public hosts are left untouched.
# Set LIVEKIT_URL_STATIC=1 to disable that and always use LIVEKIT_URL verbatim.
# LIVEKIT_URL=wss://your-livekit.example
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
# NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit.example
# LIVEKIT_URL_STATIC=1
# Fleet HMAC secret — MUST match the bodycam APK's SIP_HMAC_SECRET. Used to authenticate a
# bodycam requesting a LiveKit *publish* token (POST /api/livekit/publish-token).
# SIP_HMAC_SECRET=changeme-match-the-apk

# Staging label (shown in header when set)
NEXT_PUBLIC_STAGING=1

# Desktop app (Electron) — production mode. Set this in the `.env` beside the
# packaged exe to make it a THIN CLIENT of your deployed web app (no DB creds on
# the client). Unset = embedded local server (local dev only).
# INCOMMAND_SERVER_URL=https://incommand.your-domain.example

# Observability — error tracking. Set SENTRY_DSN and `npm i @sentry/node` to
# forward captured errors to Sentry; unset = structured logs only.
# SENTRY_DSN=

# Password hardening — set to 1 to skip the Have I Been Pwned breach check
# (e.g. air-gapped deployments). Length/complexity policy always applies.
# DISABLE_BREACH_CHECK=1

# --- Object storage (S3-compatible) — MinIO in local dev, R2/S3 in prod ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=incommand
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/incommand

# --- Redis — realtime backplane + login rate-limiting (REQUIRED in prod for
#     cross-pod rate limits; without it limiting degrades to fail-open) ---
REDIS_URL=redis://localhost:6379

# --- Auth / email ---
APP_URL=https://your-deployment.example          # base URL for invite/reset links
EMAIL_TRANSPORT=smtp                              # "console" (dev) | "smtp" (prod)
EMAIL_FROM=InCommand <no-reply@your-domain.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- DB connection pool (per pod). Behind a managed/PgBouncer transaction pooler,
#     keep this small so N replicas don't exhaust Postgres connections. ---
DB_POOL_MAX=5
# DB_IDLE_TIMEOUT=30
# DB_MAX_LIFETIME=1800
# DB_CONNECT_TIMEOUT=10
